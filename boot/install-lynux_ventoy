#!/bin/bash
build() {
    # pacstrap's kernel hook runs before customize_airootfs.sh. Compile the
    # native helper here as well so the first initramfs is complete.
    if [[ ! -x /usr/bin/lynux-ventoy-find ]]; then
        cc -O2 -Wall -Wextra -Werror /usr/local/lib/lynux/ventoy-find.c -o /usr/bin/lynux-ventoy-find || return
    fi
    add_module efivarfs
    add_binary /usr/bin/lynux-ventoy-find
    add_runscript
}
help() {
    echo 'Locate a Ventoy-hosted ISO through its EFI handoff, including UKI boot.'
}
